n.tw{overflow-x:auto}\ncode.numbered{counter-reset:ln}\ncode.numbered .line{counter-increment:ln}\ncode.numbered .line::before{content:counter(ln);display:inline-block;width:2.2ch;margin-right:1.2ch;text-align:right;color:#9ba7b4;user-select:none;-webkit-user-select:none}\npre.hl:focus-visible{outline:3px solid #79c0ff;outline-offset:2px}\n.codebox pre{padding-top:2.4rem}\n.warn{background:#fff6e6;border-left:4px solid #b36b00;padding:.75rem 1rem;margin:1rem 0;color:#3b2a00;border-radius:0 .5rem .5rem 0}\n.warn code{background:#f5ecd7}\ndetails{border:1px solid var(--line);border-radius:.75rem;padding:.5rem 1rem;margin:1rem 0;background:#fafafa}\ndetails[open]{background:#fff}\ndetails summary{cursor:pointer;font-size:1.05rem;padding:.4rem 0 .4rem 1.4rem;position:relative;list-style:none}\ndetails summary::-webkit-details-marker{display:none}\ndetails summary::before{content:\"\";position:absolute;left:.15rem;top:calc(.4rem + .8em - .3rem);border-style:solid;border-width:.3rem 0 .3rem .45rem;border-color:transparent transparent transparent currentColor;transition:transform .15s}\ndetails[open]>summary::before{transform:rotate(90deg)}\n@media (prefers-reduced-motion:reduce){details summary::before{transition:none}}\n@media (max-width:52rem){.wrap{grid-template-columns:1fr;grid-template-areas:\"top\" \"side\" \"main\" \"foot\"}\n.js .menu{display:block}.js #sidebar{display:none}.js .open #sidebar{display:block}\n#sidebar{border-right:0;border-bottom:1px solid var(--line)}main,.foot{padding:1rem}}\n@media (max-width:40rem){pre{font-size:.8rem}\n.tw caption,table.cmp caption{display:block;text-align:left;font-weight:600;margin-bottom:.5rem}\n.tw table,.tw thead,.tw tbody,.tw tr,.tw th,.tw td,table.cmp,table.cmp thead,table.cmp tbody,table.cmp tr,table.cmp th,table.cmp td{display:block}\n.tw thead,table.cmp thead{position:absolute;left:-9999px}\n.tw table,table.cmp{border:0}\n.tw tr,table.cmp tr{border:1px solid var(--line);border-radius:.5rem;margin-bottom:.75rem}\n.tw th,.tw td,table.cmp td,table.cmp th{border:none}\n.tw td:nth-of-type(1)::before{content:\"Symptom: \";font-weight:600}.tw td:nth-of-type(2)::before{content:\"Cause: \";font-weight:600}.tw td:nth-of-type(3)::before{content:\"Fix: \";font-weight:600}\ntable.cmp td:nth-of-type(1)::before{content:\"Quick Setup: \";font-weight:600}\ntable.cmp td:nth-of-type(2)::before{content:\"Isolated Setup: \";font-weight:600}}\n\n/* Agent notes: small tip at top stays collapsed; main modes section is always open */\n.agent-box{border-color:#c5c5e8;background:#f7f7fc;margin:1rem 0}\n.agent-box>summary{font-weight:600;color:#2b2a7a}\n.agent-box>summary:focus-visible{outline:3px solid var(--acc);outline-offset:2px}\n.agent-box[open]{background:#fff}\n.agent-box .agent-box{margin:.75rem 0}\n.agent-section{margin:2rem 0 1rem;padding:1rem 1.25rem;border:1px solid #c5c5e8;border-radius:.75rem;background:#f7f7fc}\n.agent-section>h2{margin-top:0;color:#2b2a7a;font-size:1.25rem}\n.agent-section details{background:#fff}\n\n/* Short agent prompts: wrap only at spaces so each URL stays on one line; the code block scrolls sideways if a URL is wider than it */\n#c-prompt, #c-prompt-iso { white-space: pre-wrap; overflow-wrap: normal; word-break: normal; }\n#c-prompt .url, #c-prompt-iso .url { white-space: nowrap; }\n/* Short file/path tokens (build adds .nb, max 32 chars) never split at - or / */\ncode .nb{white-space:nowrap}\n\n/* Intro sentence and small labels above code blocks */\n.lede{font-size:1.075rem;color:#33384d;margin:.25rem 0 1rem}\np.lbl{margin:1rem 0 .25rem;font-weight:600;font-size:.9rem}</style><style>.hl{background:#0d1117;color:#e6edf3}\n.hl .c{color:#9ba7b4}\n.hl .k{color:#ff7b72}\n.hl .kc{color:#79c0ff}\n.hl .kd{color:#ff7b72}\n.hl .kr{color:#ff7b72}\n.hl .ne{color:#ffa657}\n.hl .kn{color:#ff7b72}\n.hl .o{color:#ff7b72}\n.hl .ow{color:#ff7b72}\n.hl .s{color:#a5d6ff}\n.hl .s1{color:#a5d6ff}\n.hl .s2{color:#a5d6ff}\n.hl .sa{color:#a5d6ff}\n.hl .si{color:#ffa657}\n.hl .se{color:#79c0ff}\n.hl .sb{color:#a5d6ff}\n.hl .dl{color:#a5d6ff}\n.hl .m{color:#79c0ff}\n.hl .mi{color:#79c0ff}\n.hl .mf{color:#79c0ff}\n.hl .nb{color:#ffa657}\n.hl .bp{color:#ffa657}\n.hl .nf{color:#d2a8ff}\n.hl .fm{color:#d2a8ff}\n.hl .nc{color:#f0883e}\n.hl .nn{color:#e6edf3}\n.hl .nv{color:#ffa657}\n.hl .no{color:#79c0ff}\n.hl .nt{color:#7ee787}\n.hl .na{color:#79c0ff}\n.hl .p{color:#e6edf3}\n.hl .err{color:#ffa198}\n.hl .c,.hl .c1,.hl .cm,.hl .ch,.hl .cs{color:#9ba7b4;font-style:italic}</style><link rel=\"alternate\" type=\"text/plain\" href=\"/llms.txt\" title=\"llms.txt\"></head><body>\n<a class=\"skip\" href=\"#main\">Skip to content</a><p class=\"unoff\" role=\"note\">Unofficial prototype. Not affiliated with or endorsed by Qrypt.</p><div class=\"wrap\"><header class=\"top\"><a class=\"mark\" href=\"/\"><b>Qrypt</b> Docs <small>quickstart prototype</small></a><button class=\"menu\" aria-controls=\"sidebar\" aria-expanded=\"false\">Menu</button></header><nav id=\"sidebar\" aria-label=\"Documentation\"><ul class=\"topics\"><li class=on><a href=\"/\" aria-current=\"page\">Quickstart</a><ul><li><a href=\"#h-token\">Get a token</a></li><li><a href=\"#h-env\">Save it in .env</a></li><li><a href=\"#h-run\">Run the snippet</a></li><li><a href=\"#h-prod\">For production</a></li><li><a href=\"#h-trip\">Common pitfalls</a></li><li><a href=\"#h-agent\">AI coding agents</a></li></ul></li><li><a href=\"/troubleshooting\">Troubleshooting</a><ul><li><a href=\"/troubleshooting#codes\">HTTP status codes</a></li><li><a href=\"/troubleshooting#mistakes\">Common mistakes</a></li><li><a href=\"/troubleshooting#env\">Environment issues</a></li><li><a href=\"/troubleshooting#agent\">AI agent modes</a></li><li><a href=\"/troubleshooting#codex-bwrap\">Codex sandbox error</a></li><li><a href=\"/troubleshooting#proxy\">Proxy and TLS</a></li></ul></li></ul><p class=\"grp\">Official Qrypt docs</p><ul class=\"topics\"><li><a class=\"ext\" href=\"https://docs.qrypt.com/eaas/\" rel=\"noopener\">Quantum Entropy reference<span class=\"sr\"> (official Qrypt docs)</span></a></li><li><a class=\"ext\" href=\"https://docs.qrypt.com/eaas/rngd/\" rel=\"noopener\">RNG Tools<span class=\"sr\"> (official Qrypt docs)</span></a></li><li><a class=\"ext\" href=\"https://docs.qrypt.com/eaas/pkcs11/\" rel=\"noopener\">Qseed<span class=\"sr\"> (official Qrypt docs)</span></a></li><li><a class=\"ext\" href=\"https://docs.qrypt.com/sdk/\" rel=\"noopener\">DQKD Key Generation<span class=\"sr\"> (official Qrypt docs)</span></a></li><li><a class=\"ext\" href=\"https://docs.qrypt.com/faqs/\" rel=\"noopener\">FAQs<span class=\"sr\"> (official Qrypt docs)</span></a></li></ul><p class=\"grp\"><a href=\"/llms.txt\">llms.txt</a></p></nav><main id=\"main\">\n<h1>Make an AES-256 key from quantum entropy</h1>\n<p class=\"lede\">Qrypt's API gives you random bytes from its quantum entropy source over one HTTPS call. You turn 32 of those bytes into an ordinary AES-256 key (AES is the Advanced Encryption Standard) and use it with the standard crypto library you already have.</p>\n<details class=\"agent-box\">\n<summary>For AI coding agents</summary>\n<p>Prefer <a href=\"/llms.txt\"><code>llms.txt</code></a> (also linked in the page head) or <code>AGENTS.md</code> in the <a href=\"/qrypt-quickstart-starter.zip\">starter archive</a>. Never read, print or dump <code>.env</code> or environment variables, and never ask the human to paste the token into chat. Ask them to create <code>.env</code> themselves and confirm it is set. If <code><span class=\"nb\">QRYPT-ISOLATED.txt</span></code> exists you have no token on purpose: run mock tests and ask the human to run <code><span class=\"nb\">agent-sandbox/verify.sh</span></code> on the host. Human-readable modes: <a href=\"#h-agent\">below</a>.</p>\n</details>\n\n<p><span class=\"time\">Time: about 5 minutes</span> No SDK needed: one HTTPS GET, then standard crypto.</p>\n<h2 id=\"h-token\">1. Get a token</h2>\n<p>Create an account at <a href=\"https://portal.qrypt.com/trial-signup-entropy\">portal.qrypt.com/trial-signup-entropy</a> and generate a token for the <strong>Entropy</strong> service. It is shown only once. Treat it like a password: anyone who has it can use your account's entropy quota.</p>\n<p>The trial form asks for two things: your full name and a work email. It does not say what the trial quota is, so check the portal after you sign up.</p>\n<h2 id=\"h-env\">2. Save it in <code>.env</code></h2>\n<div class=\"codebox\"><button class=\"copy\" data-target=\"c-env\" aria-label=\"Copy .env line\">Copy</button><pre class=\"hl\" tabindex=\"0\"><code id=\"c-env\" data-lang=\"env\"><span class=\"line\"><span class=\"nv\">QRYPT_API_KEY</span><span class=\"o\">=</span>paste-your-token-here</span></code></pre></div>\n<p>Put <code>.env</code> next to the script and add it to <code>.gitignore</code>. Never print it, not even partly (no <code>cat .env</code>). To check the file exists, run <code>test <span class=\"nb\">-f</span> .env &amp;&amp; echo set</code>.</p>\n<h2 id=\"h-run\">3. Run the snippet</h2>\n<p>Copy a snippet below, or download the <a href=\"/qrypt-quickstart-starter.zip\">starter archive</a> (zip): both snippets, <code>requirements.txt</code>, <code>.env.example</code>, a mock server with tests, <code>AGENTS.md</code>, a <code>Makefile</code> and the Isolated Setup files. Inside it, <code>make check</code> runs every test against the mock with no token.</p>\n<div role=\"tablist\" aria-label=\"Language\">\n<button role=\"tab\" id=\"t-py\" aria-selected=\"true\" aria-controls=\"p-py\">Python</button>\n<button role=\"tab\" id=\"t-js\" aria-selected=\"false\" aria-controls=\"p-js\" tabindex=\"-1\">Node</button></div>\n<section role=\"tabpanel\" id=\"p-py\" aria-labelledby=\"t-py\" tabindex=\"0\">\n<p>Save the code as <code>quickstart.py</code>. Python 3.9+. Uses <code>requests</code>: Cloudflare blocks Python's built-in <code>urllib</code> User-Agent.</p>\n<div class=\"codebox\"><button class=\"copy\" data-target=\"c-pyi\" aria-label=\"Copy Python install command\">Copy</button><pre class=\"hl\" tabindex=\"0\"><code id=\"c-pyi\" data-lang=\"bash\"><span class=\"line\">python3<span class=\"w\"> </span>-m<span class=\"w\"> </span>venv<span class=\"w\"> </span>.venv<span class=\"w\"> </span><span class=\"o\">&amp;&amp;</span><span class=\"w\"> </span>.venv/bin/pip<span class=\"w\"> </span>install<span class=\"w\"> </span>requests<span class=\"w\"> </span>cryptography<span class=\"w\"> </span>python-dotenv</span></code></pre></div>\n<div class=\"codebox\"><button class=\"copy\" data-target=\"c-py\" aria-label=\"Copy Python quickstart code\">Copy</button><pre class=\"hl\" tabindex=\"0\"><code id=\"c-py\" data-lang=\"python\" class=\"numbered\"><span class=\"line\"><span class=\"c1\"># Qrypt quickstart (Python): 1 KiB of quantum entropy -&gt; AES-256-GCM key.</span></span>\n<span class=\"line\"><span class=\"c1\"># Setup: pip install requests cryptography python-dotenv</span></span>\n<span class=\"line\"><span class=\"c1\"># Then put QRYPT_API_KEY=[REDACTED] token&gt; in a .env file next to this script.</span></span>\n<span class=\"line\"><span class=\"kn\">import</span><span class=\"w\"> </span><span class=\"nn\">base64</span></span>\n<span class=\"line\"><span class=\"kn\">import</span><span class=\"w\"> </span><span class=\"nn\">os</span></span>\n<span class=\"line\"><span class=\"kn\">import</span><span class=\"w\"> </span><span class=\"nn\">sys</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span class=\"kn\">import</span><span class=\"w\"> </span><span class=\"nn\">requests</span></span>\n<span class=\"line\"><span class=\"kn\">from</span><span class=\"w\"> </span><span class=\"nn\">cryptography.hazmat.primitives.ciphers.aead</span><span class=\"w\"> </span><span class=\"kn\">import</span> <span class=\"n\">AESGCM</span></span>\n<span class=\"line\"><span class=\"kn\">from</span><span class=\"w\"> </span><span class=\"nn\">dotenv</span><span class=\"w\"> </span><span class=\"kn\">import</span> <span class=\"n\">load_dotenv</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span class=\"n\">API</span> <span class=\"o\">=</span> <span class=\"n\">os</span><span class=\"o\">.</span><span class=\"n\">getenv</span><span class=\"p\">(</span><span class=\"s2\">&quot;QRYPT_BASE_URL&quot;</span><span class=\"p\">,</span> <span class=\"s2\">&quot;https://api-eus.qrypt.com&quot;</span><span class=\"p\">)</span>  <span class=\"c1\"># mock override</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span class=\"c1\"># One friendly message per failure. We never retry automatically.</span></span>\n<span class=\"line\"><span class=\"n\">HELP</span> <span class=\"o\">=</span> <span class=\"p\">{</span><span class=\"mi\">400</span><span class=\"p\">:</span> <span class=\"s2\">&quot;400: size must be 1-512. It counts KiB, not bytes.&quot;</span><span class=\"p\">,</span></span>\n<span class=\"line\">        <span class=\"kc\">None</span><span class=\"p\">:</span> <span class=\"s2\">&quot;QRYPT_API_KEY is missing: add to .env. Token: portal.qrypt.com/trial-signup-entropy&quot;</span><span class=\"p\">,</span></span>\n<span class=\"line\">        <span class=\"mi\">401</span><span class=\"p\">:</span> <span class=\"s2\">&quot;401: Authorization header missing, malformed or expired.&quot;</span><span class=\"p\">,</span></span>\n<span class=\"line\">        <span class=\"mi\">403</span><span class=\"p\">:</span> <span class=\"s2\">&quot;403: Token invalid OR monthly quota used. Check the token first.&quot;</span><span class=\"p\">,</span></span>\n<span class=\"line\">        <span class=\"mi\">429</span><span class=\"p\">:</span> <span class=\"s2\">&quot;429: rate limited. Live can return 429 about 1 s after a single &quot;</span></span>\n<span class=\"line\">             <span class=\"s2\">&quot;prior call; wait 10 s or more and never loop.&quot;</span><span class=\"p\">}</span></span>\n<span class=\"line\"><span class=\"c1\"># 500, 503 and anything else: Qrypt is busy or erroring, so try again later.</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span class=\"c1\"># Step 1: read the token from .env. Never print or log it.</span></span>\n<span class=\"line\"><span class=\"n\">load_dotenv</span><span class=\"p\">()</span></span>\n<span class=\"line\"><span class=\"n\">token</span> <span class=\"o\">=</span> <span class=\"n\">os</span><span class=\"o\">.</span><span class=\"n\">getenv</span><span class=\"p\">(</span><span class=\"s2\">&quot;QRYPT_API_KEY&quot;</span><span class=\"p\">)</span> <span class=\"ow\">or</span> <span class=\"n\">sys</span><span class=\"o\">.</span><span class=\"n\">exit</span><span class=\"p\">(</span><span class=\"n\">HELP</span><span class=\"p\">[</span><span class=\"kc\">None</span><span class=\"p\">])</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span class=\"c1\"># Step 2: fetch 1 KiB of entropy. A custom User-Agent avoids Cloudflare&#39;s</span></span>\n<span class=\"line\"><span class=\"c1\"># block on Python&#39;s urllib; X-Qrypt-Client tags quickstart traffic.</span></span>\n<span class=\"line\"><span class=\"n\">headers</span> <span class=\"o\">=</span> <span class=\"p\">{</span></span>\n<span class=\"line\">    <span class=\"s2\">&quot;Authorization&quot;</span><span class=\"p\">:</span> <span class=\"sa\">f</span><span class=\"s2\">&quot;Bearer </span><span class=\"si\">{</span><span class=\"n\">token</span><span class=\"si\">}</span><span class=\"s2\">&quot;</span><span class=\"p\">,</span> <span class=\"s2\">&quot;Accept&quot;</span><span class=\"p\">:</span> <span class=\"s2\">&quot;application/json&quot;</span><span class=\"p\">,</span></span>\n<span class=\"line\">    <span class=\"s2\">&quot;User-Agent&quot;</span><span class=\"p\">:</span> <span class=\"s2\">&quot;qrypt-quickstart/1.0&quot;</span><span class=\"p\">,</span> <span class=\"s2\">&quot;X-Qrypt-Client&quot;</span><span class=\"p\">:</span> <span class=\"s2\">&quot;quickstart-py/1.0&quot;</span><span class=\"p\">}</span></span>\n<span class=\"line\"><span class=\"k\">try</span><span class=\"p\">:</span></span>\n<span class=\"line\">    <span class=\"n\">resp</span> <span class=\"o\">=</span> <span class=\"n\">requests</span><span class=\"o\">.</span><span class=\"n\">get</span><span class=\"p\">(</span><span class=\"sa\">f</span><span class=\"s2\">&quot;</span><span class=\"si\">{</span><span class=\"n\">API</span><span class=\"si\">}</span><span class=\"s2\">/api/v1/quantum-entropy&quot;</span><span class=\"p\">,</span> <span class=\"n\">params</span><span class=\"o\">=</span><span class=\"p\">{</span><span class=\"s2\">&quot;size&quot;</span><span class=\"p\">:</span> <span class=\"mi\">1</span><span class=\"p\">},</span></span>\n<span class=\"line\">                        <span class=\"n\">headers</span><span class=\"o\">=</span><span class=\"n\">headers</span><span class=\"p\">,</span> <span class=\"n\">timeout</span><span class=\"o\">=</span><span class=\"mi\">15</span><span class=\"p\">)</span></span>\n<span class=\"line\">    <span class=\"k\">if</span> <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">status_code</span> <span class=\"o\">!=</span> <span class=\"mi\">200</span><span class=\"p\">:</span></span>\n<span class=\"line\">        <span class=\"n\">sys</span><span class=\"o\">.</span><span class=\"n\">exit</span><span class=\"p\">(</span><span class=\"n\">HELP</span><span class=\"o\">.</span><span class=\"n\">get</span><span class=\"p\">(</span><span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">status_code</span><span class=\"p\">,</span> <span class=\"sa\">f</span><span class=\"s2\">&quot;</span><span class=\"si\">{</span><span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">status_code</span><span class=\"si\">}</span><span class=\"s2\">: Qrypt is &quot;</span></span>\n<span class=\"line\">                          <span class=\"s2\">&quot;busy or erroring. Try again shortly.&quot;</span><span class=\"p\">))</span></span>\n<span class=\"line\">    <span class=\"n\">entropy_b64</span> <span class=\"o\">=</span> <span class=\"n\">resp</span><span class=\"o\">.</span><span class=\"n\">json</span><span class=\"p\">()[</span><span class=\"s2\">&quot;random&quot;</span><span class=\"p\">][</span><span class=\"mi\">0</span><span class=\"p\">]</span></span>\n<span class=\"line\"><span class=\"k\">except</span> <span class=\"p\">(</span><span class=\"n\">requests</span><span class=\"o\">.</span><span class=\"n\">RequestException</span><span class=\"p\">,</span> <span class=\"ne\">ValueError</span><span class=\"p\">):</span></span>\n<span class=\"line\">    <span class=\"n\">sys</span><span class=\"o\">.</span><span class=\"n\">exit</span><span class=\"p\">(</span><span class=\"s2\">&quot;Network error or non-JSON reply: check proxy/TLS, retry soon.&quot;</span><span class=\"p\">)</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span class=\"c1\"># Step 3: decode first, then keep 32 bytes as the AES-256 key.</span></span>\n<span class=\"line\"><span class=\"n\">key</span> <span class=\"o\">=</span> <span class=\"n\">base64</span><span class=\"o\">.</span><span class=\"n\">b64decode</span><span class=\"p\">(</span><span class=\"n\">entropy_b64</span><span class=\"p\">)[:</span><span class=\"mi\">32</span><span class=\"p\">]</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span class=\"c1\"># Step 4: encrypt and decrypt a sample message with AES-256-GCM.</span></span>\n<span class=\"line\"><span class=\"n\">aes</span><span class=\"p\">,</span> <span class=\"n\">nonce</span><span class=\"p\">,</span> <span class=\"n\">message</span> <span class=\"o\">=</span> <span class=\"n\">AESGCM</span><span class=\"p\">(</span><span class=\"n\">key</span><span class=\"p\">),</span> <span class=\"n\">os</span><span class=\"o\">.</span><span class=\"n\">urandom</span><span class=\"p\">(</span><span class=\"mi\">12</span><span class=\"p\">),</span> <span class=\"sa\">b</span><span class=\"s2\">&quot;hello, quantum entropy&quot;</span></span>\n<span class=\"line\"><span class=\"k\">assert</span> <span class=\"n\">aes</span><span class=\"o\">.</span><span class=\"n\">decrypt</span><span class=\"p\">(</span><span class=\"n\">nonce</span><span class=\"p\">,</span> <span class=\"n\">aes</span><span class=\"o\">.</span><span class=\"n\">encrypt</span><span class=\"p\">(</span><span class=\"n\">nonce</span><span class=\"p\">,</span> <span class=\"n\">message</span><span class=\"p\">,</span> <span class=\"kc\">None</span><span class=\"p\">),</span> <span class=\"kc\">None</span><span class=\"p\">)</span> <span class=\"o\">==</span> <span class=\"n\">message</span></span>\n<span class=\"line\"><span class=\"nb\">print</span><span class=\"p\">(</span><span class=\"s2\">&quot;Success: AES-256-GCM round trip with a Qrypt key (not shown).&quot;</span><span class=\"p\">)</span></span>\n</code></pre></div>\n<div class=\"codebox\"><button class=\"copy\" data-target=\"c-pyr\" aria-label=\"Copy Python run command\">Copy</button><pre class=\"hl\" tabindex=\"0\"><code id=\"c-pyr\" data-lang=\"bash\"><span class=\"line\">.venv/bin/python<span class=\"w\"> </span>quickstart.py</span></code></pre></div></section>\n<section role=\"tabpanel\" id=\"p-js\" aria-labelledby=\"t-js\" tabindex=\"0\" hidden>\n<p><strong>Save the code as <code>quickstart.mjs</code></strong>, not <code>.js</code>. It uses ES module <code>import</code> and top-level <code>await</code>; a <code>.js</code> file fails with <code>SyntaxError</code> on older Node unless <code>package.json</code> sets <code>\"type\": \"module\"</code>. Node 20.12+ (built-in <code>fetch</code> and <code>process.loadEnvFile</code>). No dependencies.</p>\n<div class=\"codebox\"><button class=\"copy\" data-target=\"c-js\" aria-label=\"Copy Node quickstart code\">Copy</button><pre class=\"hl\" tabindex=\"0\"><code id=\"c-js\" data-lang=\"js\" class=\"numbered\"><span class=\"line\"><span class=\"c1\">// Qrypt quickstart (Node 20.12+): 1 KiB of quantum entropy -&gt; AES-256-GCM key.</span></span>\n<span class=\"line\"><span class=\"c1\">// No dependencies. Put QRYPT_API_KEY=[REDACTED] token&gt; in a .env file here.</span></span>\n<span class=\"line\"><span class=\"k\">import</span><span class=\"w\"> </span><span class=\"nx\">assert</span><span class=\"w\"> </span><span class=\"kr\">from</span><span class=\"w\"> </span><span class=\"s2\">&quot;node:assert&quot;</span><span class=\"p\">;</span></span>\n<span class=\"line\"><span class=\"k\">import</span><span class=\"w\"> </span><span class=\"p\">{</span><span class=\"w\"> </span><span class=\"nx\">existsSync</span><span class=\"w\"> </span><span class=\"p\">}</span><span class=\"w\"> </span><span class=\"kr\">from</span><span class=\"w\"> </span><span class=\"s2\">&quot;node:fs&quot;</span><span class=\"p\">;</span></span>\n<span class=\"line\"><span class=\"k\">import</span><span class=\"w\"> </span><span class=\"p\">{</span><span class=\"w\"> </span><span class=\"nx\">createCipheriv</span><span class=\"p\">,</span><span class=\"w\"> </span><span class=\"nx\">createDecipheriv</span><span class=\"p\">,</span><span class=\"w\"> </span><span class=\"nx\">randomBytes</span><span class=\"w\"> </span><span class=\"p\">}</span><span class=\"w\"> </span><span class=\"kr\">from</span><span class=\"w\"> </span><span class=\"s2\">&quot;node:crypto&quot;</span><span class=\"p\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span class=\"kd\">const</span><span class=\"w\"> </span><span class=\"nx\">API</span><span class=\"w\"> </span><span class=\"o\">=</span><span class=\"w\"> </span><span class=\"nx\">process</span><span class=\"p\">.</span><span class=\"nx\">env</span><span class=\"p\">.</span><span class=\"nx\">QRYPT_BASE_URL</span><span class=\"w\"> </span><span class=\"o\">??</span><span class=\"w\"> </span><span class=\"s2\">&quot;https://api-eus.qrypt.com&quot;</span><span class=\"p\">;</span><span class=\"w\"> </span><span class=\"c1\">// mock</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span class=\"c1\">// One friendly message per failure. We never retry automatically.</span></span>\n<span class=\"line\"><span class=\"kd\">const</span><span class=\"w\"> </span><span class=\"nx\">HELP</span><span class=\"w\"> </span><span class=\"o\">=</span><span class=\"w\"> </span><span class=\"p\">{</span><span class=\"w\"> </span><span class=\"mf\">400</span><span class=\"o\">:</span><span class=\"w\"> </span><span class=\"s2\">&quot;400: size must be 1-512. It counts KiB, not bytes.&quot;</span><span class=\"p\">,</span></span>\n<span class=\"line\"><span class=\"w\">  </span><span class=\"nx\">missing</span><span class=\"o\">:</span><span class=\"w\"> </span><span class=\"s2\">&quot;QRYPT_API_KEY is missing: add to .env. Token: portal.qrypt.com/trial-signup-entropy&quot;</span><span class=\"p\">,</span></span>\n<span class=\"line\"><span class=\"w\">  </span><span class=\"nx\">network</span><span class=\"o\">:</span><span class=\"w\"> </span><span class=\"s2\">&quot;Network error or non-JSON reply: check proxy/TLS, retry soon.&quot;</span><span class=\"p\">,</span></span>\n<span class=\"line\"><span class=\"w\">  </span><span class=\"mf\">401</span><span class=\"o\">:</span><span class=\"w\"> </span><span class=\"s2\">&quot;401: Authorization header missing, malformed or expired.&quot;</span><span class=\"p\">,</span></span>\n<span class=\"line\"><span class=\"w\">  </span><span class=\"mf\">403</span><span class=\"o\">:</span><span class=\"w\"> </span><span class=\"s2\">&quot;403: Token invalid OR monthly quota used. Check the token first.&quot;</span><span class=\"p\">,</span></span>\n<span class=\"line\"><span class=\"w\">  </span><span class=\"mf\">429</span><span class=\"o\">:</span><span class=\"w\"> </span><span class=\"s2\">&quot;429: rate limited. Live can return 429 about 1 s after a single &quot;</span><span class=\"w\"> </span><span class=\"o\">+</span></span>\n<span class=\"line\"><span class=\"w\">    </span><span class=\"s2\">&quot;prior call; wait 10 s or more and never loop.&quot;</span><span class=\"w\"> </span><span class=\"p\">};</span></span>\n<span class=\"line\"><span class=\"c1\">// 500, 503 and anything else: Qrypt is busy or erroring, so try again later.</span></span>\n<span class=\"line\"><span class=\"kd\">const</span><span class=\"w\"> </span><span class=\"nx\">fail</span><span class=\"w\"> </span><span class=\"o\">=</span><span class=\"w\"> </span><span class=\"p\">(</span><span class=\"nx\">msg</span><span class=\"p\">)</span><span class=\"w\"> </span><span class=\"p\">=&gt;</span><span class=\"w\"> </span><span class=\"p\">{</span><span class=\"w\"> </span><span class=\"nx\">console</span><span class=\"p\">.</span><span class=\"nx\">error</span><span class=\"p\">(</span><span class=\"nx\">msg</span><span class=\"p\">);</span><span class=\"w\"> </span><span class=\"nx\">process</span><span class=\"p\">.</span><span class=\"nx\">exit</span><span class=\"p\">(</span><span class=\"mf\">1</span><span class=\"p\">);</span><span class=\"w\"> </span><span class=\"p\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span class=\"c1\">// Step 1: read the token from .env. Never print or log it.</span></span>\n<span class=\"line\"><span class=\"k\">if</span><span class=\"w\"> </span><span class=\"p\">(</span><span class=\"nx\">existsSync</span><span class=\"p\">(</span><span class=\"s2\">&quot;.env&quot;</span><span class=\"p\">))</span><span class=\"w\"> </span><span class=\"nx\">process</span><span class=\"p\">.</span><span class=\"nx\">loadEnvFile</span><span class=\"p\">(</span><span class=\"s2\">&quot;.env&quot;</span><span class=\"p\">);</span></span>\n<span class=\"line\"><span class=\"kd\">const</span><span class=\"w\"> </span><span class=\"nx\">token</span><span class=\"w\"> </span><span class=\"o\">=</span><span class=\"w\"> </span><span class=\"nx\">process</span><span class=\"p\">.</span><span class=\"nx\">env</span><span class=\"p\">.</span><span class=\"nx\">QRYPT_API_KEY</span><span class=\"w\"> </span><span class=\"o\">||</span><span class=\"w\"> </span><span class=\"nx\">fail</span><span class=\"p\">(</span><span class=\"nx\">HELP</span><span class=\"p\">.</span><span class=\"nx\">missing</span><span class=\"p\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span class=\"c1\">// Step 2: fetch 1 KiB of entropy (size counts KiB, not bytes).</span></span>\n<span class=\"line\"><span class=\"kd\">const</span><span class=\"w\"> </span><span class=\"nx\">headers</span><span class=\"w\"> </span><span class=\"o\">=</span><span class=\"w\"> </span><span class=\"p\">{</span><span class=\"w\"> </span><span class=\"nx\">Authorization</span><span class=\"o\">:</span><span class=\"w\"> </span><span class=\"sb\">`Bearer </span><span class=\"si\">${</span><span class=\"nx\">token</span><span class=\"si\">}</span><span class=\"sb\">`</span><span class=\"p\">,</span><span class=\"w\"> </span><span class=\"nx\">Accept</span><span class=\"o\">:</span><span class=\"w\"> </span><span class=\"s2\">&quot;application/json&quot;</span><span class=\"p\">,</span></span>\n<span class=\"line\"><span class=\"w\">  </span><span class=\"s2\">&quot;User-Agent&quot;</span><span class=\"o\">:</span><span class=\"w\"> </span><span class=\"s2\">&quot;qrypt-quickstart/1.0&quot;</span><span class=\"p\">,</span><span class=\"w\"> </span><span class=\"s2\">&quot;X-Qrypt-Client&quot;</span><span class=\"o\">:</span><span class=\"w\"> </span><span class=\"s2\">&quot;quickstart-js/1.0&quot;</span><span class=\"w\"> </span><span class=\"p\">};</span></span>\n<span class=\"line\"><span class=\"kd\">const</span><span class=\"w\"> </span><span class=\"nx\">url</span><span class=\"w\"> </span><span class=\"o\">=</span><span class=\"w\"> </span><span class=\"sb\">`</span><span class=\"si\">${</span><span class=\"nx\">API</span><span class=\"si\">}</span><span class=\"sb\">/api/v1/quantum-entropy?size=1`</span><span class=\"p\">;</span></span>\n<span class=\"line\"><span class=\"kd\">const</span><span class=\"w\"> </span><span class=\"nx\">res</span><span class=\"w\"> </span><span class=\"o\">=</span><span class=\"w\"> </span><span class=\"k\">await</span><span class=\"w\"> </span><span class=\"nx\">fetch</span><span class=\"p\">(</span><span class=\"nx\">url</span><span class=\"p\">,</span><span class=\"w\"> </span><span class=\"p\">{</span><span class=\"w\"> </span><span class=\"nx\">headers</span><span class=\"w\"> </span><span class=\"p\">}).</span><span class=\"k\">catch</span><span class=\"p\">(()</span><span class=\"w\"> </span><span class=\"p\">=&gt;</span><span class=\"w\"> </span><span class=\"nx\">fail</span><span class=\"p\">(</span><span class=\"nx\">HELP</span><span class=\"p\">.</span><span class=\"nx\">network</span><span class=\"p\">));</span></span>\n<span class=\"line\"><span class=\"k\">if</span><span class=\"w\"> </span><span class=\"p\">(</span><span class=\"nx\">res</span><span class=\"p\">.</span><span class=\"nx\">status</span><span class=\"w\"> </span><span class=\"o\">!==</span><span class=\"w\"> </span><span class=\"mf\">200</span><span class=\"p\">)</span><span class=\"w\"> </span><span class=\"nx\">fail</span><span class=\"p\">(</span><span class=\"nx\">HELP</span><span class=\"p\">[</span><span class=\"nx\">res</span><span class=\"p\">.</span><span class=\"nx\">status</span><span class=\"p\">]</span><span class=\"w\"> </span><span class=\"o\">??</span></span>\n<span class=\"line\"><span class=\"w\">  </span><span class=\"sb\">`</span><span class=\"si\">${</span><span class=\"nx\">res</span><span class=\"p\">.</span><span class=\"nx\">status</span><span class=\"si\">}</span><span class=\"sb\">: Qrypt is busy or erroring. Try again shortly.`</span><span class=\"p\">);</span></span>\n<span class=\"line\"><span class=\"kd\">const</span><span class=\"w\"> </span><span class=\"nx\">body</span><span class=\"w\"> </span><span class=\"o\">=</span><span class=\"w\"> </span><span class=\"k\">await</span><span class=\"w\"> </span><span class=\"nx\">res</span><span class=\"p\">.</span><span class=\"nx\">json</span><span class=\"p\">().</span><span class=\"k\">catch</span><span class=\"p\">(()</span><span class=\"w\"> </span><span class=\"p\">=&gt;</span><span class=\"w\"> </span><span class=\"nx\">fail</span><span class=\"p\">(</span><span class=\"nx\">HELP</span><span class=\"p\">.</span><span class=\"nx\">network</span><span class=\"p\">));</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span class=\"c1\">// Step 3: decode first, then keep 32 bytes as the AES-256 key.</span></span>\n<span class=\"line\"><span class=\"kd\">const</span><span class=\"w\"> </span><span class=\"nx\">key</span><span class=\"w\"> </span><span class=\"o\">=</span><span class=\"w\"> </span><span class=\"nx\">Buffer</span><span class=\"p\">.</span><span class=\"kr\">from</span><span class=\"p\">(</span><span class=\"nx\">body</span><span class=\"p\">.</span><span class=\"nx\">random</span><span class=\"p\">[</span><span class=\"mf\">0</span><span class=\"p\">],</span><span class=\"w\"> </span><span class=\"s2\">&quot;base64&quot;</span><span class=\"p\">).</span><span class=\"nx\">subarray</span><span class=\"p\">(</span><span class=\"mf\">0</span><span class=\"p\">,</span><span class=\"w\"> </span><span class=\"mf\">32</span><span class=\"p\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span class=\"c1\">// Step 4: encrypt and decrypt a sample message with AES-256-GCM.</span></span>\n<span class=\"line\"><span class=\"kd\">const</span><span class=\"w\"> </span><span class=\"nx\">GCM</span><span class=\"w\"> </span><span class=\"o\">=</span><span class=\"w\"> </span><span class=\"s2\">&quot;aes-256-gcm&quot;</span><span class=\"p\">,</span><span class=\"w\"> </span><span class=\"nx\">iv</span><span class=\"w\"> </span><span class=\"o\">=</span><span class=\"w\"> </span><span class=\"nx\">randomBytes</span><span class=\"p\">(</span><span class=\"mf\">12</span><span class=\"p\">),</span><span class=\"w\"> </span><span class=\"nx\">message</span><span class=\"w\"> </span><span class=\"o\">=</span><span class=\"w\"> </span><span class=\"s2\">&quot;hello, quantum&quot;</span><span class=\"p\">;</span></span>\n<span class=\"line\"><span class=\"kd\">const</span><span class=\"w\"> </span><span class=\"nx\">enc</span><span class=\"w\"> </span><span class=\"o\">=</span><span class=\"w\"> </span><span class=\"nx\">createCipheriv</span><span class=\"p\">(</span><span class=\"nx\">GCM</span><span class=\"p\">,</span><span class=\"w\"> </span><span class=\"nx\">key</span><span class=\"p\">,</span><span class=\"w\"> </span><span class=\"nx\">iv</span><span class=\"p\">);</span></span>\n<span class=\"line\"><span class=\"kd\">const</span><span class=\"w\"> </span><span class=\"nx\">sealed</span><span class=\"w\"> </span><span class=\"o\">=</span><span class=\"w\"> </span><span class=\"nx\">Buffer</span><span class=\"p\">.</span><span class=\"nx\">concat</span><span class=\"p\">([</span><span class=\"nx\">enc</span><span class=\"p\">.</span><span class=\"nx\">update</span><span class=\"p\">(</span><span class=\"nx\">message</span><span class=\"p\">,</span><span class=\"w\"> </span><span class=\"s2\">&quot;utf8&quot;</span><span class=\"p\">),</span><span class=\"w\"> </span><span class=\"nx\">enc</span><span class=\"p\">.</span><span class=\"kr\">final</span><span class=\"p\">()]);</span></span>\n<span class=\"line\"><span class=\"kd\">const</span><span class=\"w\"> </span><span class=\"nx\">dec</span><span class=\"w\"> </span><span class=\"o\">=</span><span class=\"w\"> </span><span class=\"nx\">createDecipheriv</span><span class=\"p\">(</span><span class=\"nx\">GCM</span><span class=\"p\">,</span><span class=\"w\"> </span><span class=\"nx\">key</span><span class=\"p\">,</span><span class=\"w\"> </span><span class=\"nx\">iv</span><span class=\"p\">).</span><span class=\"nx\">setAuthTag</span><span class=\"p\">(</span><span class=\"nx\">enc</span><span class=\"p\">.</span><span class=\"nx\">getAuthTag</span><span class=\"p\">());</span></span>\n<span class=\"line\"><span class=\"nx\">assert</span><span class=\"p\">.</span><span class=\"nx\">equal</span><span class=\"p\">(</span><span class=\"nx\">dec</span><span class=\"p\">.</span><span class=\"nx\">update</span><span class=\"p\">(</span><span class=\"nx\">sealed</span><span class=\"p\">,</span><span class=\"w\"> </span><span class=\"kc\">null</span><span class=\"p\">,</span><span class=\"w\"> </span><span class=\"s2\">&quot;utf8&quot;</span><span class=\"p\">)</span><span class=\"w\"> </span><span class=\"o\">+</span><span class=\"w\"> </span><span class=\"nx\">dec</span><span class=\"p\">.</span><span class=\"kr\">final</span><span class=\"p\">(</span><span class=\"s2\">&quot;utf8&quot;</span><span class=\"p\">),</span><span class=\"w\"> </span><span class=\"nx\">message</span><span class=\"p\">);</span></span>\n<span class=\"line\"><span class=\"nx\">console</span><span class=\"p\">.</span><span class=\"nx\">log</span><span class=\"p\">(</span><span class=\"s2\">&quot;Success: AES-256-GCM round trip with a Qrypt key (not shown).&quot;</span><span class=\"p\">);</span></span>\n</code></pre></div>\n<div class=\"codebox\"><button class=\"copy\" data-target=\"c-jsr\" aria-label=\"Copy Node run command\">Copy</button><pre class=\"hl\" tabindex=\"0\"><code id=\"c-jsr\" data-lang=\"bash\"><span class=\"line\">node<span class=\"w\"> </span>quickstart.mjs</span></code></pre></div></section>\n<h2 id=\"h-api\">What the API returns</h2>\n<p>One base64 string per KiB requested. Decode it before use; it never contains the key itself.</p>\n<pre class=\"hl\" tabindex=\"0\"><code data-lang=\"json\"><span class=\"line\"><span class=\"p\">{</span></span>\n<span class=\"line\"><span class=\"w\">  </span><span class=\"nt\">&quot;random&quot;</span><span class=\"p\">:</span><span class=\"w\"> </span><span class=\"p\">[</span><span class=\"s2\">&quot;&lt;base64 string: 1,024 random bytes when decoded&gt;&quot;</span><span class=\"p\">],</span></span>\n<span class=\"line\"><span class=\"w\">  </span><span class=\"nt\">&quot;size&quot;</span><span class=\"p\">:</span><span class=\"w\"> </span><span class=\"mi\">1</span></span>\n<span class=\"line\"><span class=\"p\">}</span></span></code></pre>\n<h2 id=\"h-output\">4. Expected output</h2>\n<pre class=\"hl\" tabindex=\"0\"><code data-lang=\"text\"><span class=\"line\">Success: <span class=\"nb\">AES-256-GCM</span> round trip with a Qrypt key (not shown).</span></code></pre>\n<h2 id=\"h-fp\">Optional: see that the key changes</h2>\n<p>Add these lines to the end of your script to print the first 8 hex characters of a SHA-256 hash of the key. Each run should show a different value. A one-way hash this short shows the key changed without revealing it.</p>\n<p class=\"lbl\">Python (end of <code>quickstart.py</code>)</p>\n<div class=\"codebox\"><button class=\"copy\" data-target=\"c-fp-py\" aria-label=\"Copy Python fingerprint lines\">Copy</button><pre class=\"hl\" tabindex=\"0\"><code id=\"c-fp-py\" data-lang=\"python\"><span class=\"line\"><span class=\"kn\">import</span><span class=\"w\"> </span><span class=\"nn\">hashlib</span>  <span class=\"c1\"># optional extra</span></span>\n<span class=\"line\"><span class=\"nb\">print</span><span class=\"p\">(</span><span class=\"s2\">&quot;Key fingerprint:&quot;</span><span class=\"p\">,</span> <span class=\"n\">hashlib</span><span class=\"o\">.</span><span class=\"n\">sha256</span><span class=\"p\">(</span><span class=\"n\">key</span><span class=\"p\">)</span><span class=\"o\">.</span><span class=\"n\">hexdigest</span><span class=\"p\">()[:</span><span class=\"mi\">8</span><span class=\"p\">])</span></span></code></pre></div>\n<p class=\"lbl\">Node (end of <code>quickstart.mjs</code>)</p>\n<div class=\"codebox\"><button class=\"copy\" data-target=\"c-fp-js\" aria-label=\"Copy Node fingerprint lines\">Copy</button><pre class=\"hl\" tabindex=\"0\"><code id=\"c-fp-js\" data-lang=\"js\"><span class=\"line\"><span class=\"kd\">const</span><span class=\"w\"> </span><span class=\"p\">{</span><span class=\"w\"> </span><span class=\"nx\">createHash</span><span class=\"w\"> </span><span class=\"p\">}</span><span class=\"w\"> </span><span class=\"o\">=</span><span class=\"w\"> </span><span class=\"k\">await</span><span class=\"w\"> </span><span class=\"k\">import</span><span class=\"p\">(</span><span class=\"s2\">&quot;node:crypto&quot;</span><span class=\"p\">);</span><span class=\"w\"> </span><span class=\"c1\">// optional extra</span></span>\n<span class=\"line\"><span class=\"kd\">const</span><span class=\"w\"> </span><span class=\"nx\">fp</span><span class=\"w\"> </span><span class=\"o\">=</span><span class=\"w\"> </span><span class=\"nx\">createHash</span><span class=\"p\">(</span><span class=\"s2\">&quot;sha256&quot;</span><span class=\"p\">).</span><span class=\"nx\">update</span><span class=\"p\">(</span><span class=\"nx\">key</span><span class=\"p\">).</span><span class=\"nx\">digest</span><span class=\"p\">(</span><span class=\"s2\">&quot;hex&quot;</span><span class=\"p\">);</span></span>\n<span class=\"line\"><span class=\"nx\">console</span><span class=\"p\">.</span><span class=\"nx\">log</span><span class=\"p\">(</span><span class=\"s2\">&quot;Key fingerprint:&quot;</span><span class=\"p\">,</span><span class=\"w\"> </span><span class=\"nx\">fp</span><span class=\"p\">.</span><span class=\"nx\">slice</span><span class=\"p\">(</span><span class=\"mf\">0</span><span class=\"p\">,</span><span class=\"w\"> </span><span class=\"mf\">8</span><span class=\"p\">));</span></span></code></pre></div>\n<h2 id=\"h-prod\">For production: mix in local randomness</h2>\n<p>Qrypt's service delivers the raw bytes to you, so a key made only from them depends on trusting that service and the connection. In production, mix the Qrypt bytes with your own machine's randomness through HKDF (HMAC-based Key Derivation Function), so the key stays secret even if one source is weak or seen by someone else. Replace step 3 of the snippet with:</p>\n<p class=\"lbl\">Python</p>\n<div class=\"codebox\"><button class=\"copy\" data-target=\"c-prod-py\" aria-label=\"Copy Python production HKDF code\">Copy</button><pre class=\"hl\" tabindex=\"0\"><code id=\"c-prod-py\" data-lang=\"python\"><span class=\"line\"><span class=\"kn\">from</span><span class=\"w\"> </span><span class=\"nn\">cryptography.hazmat.primitives</span><span class=\"w\"> </span><span class=\"kn\">import</span> <span class=\"n\">hashes</span></span>\n<span class=\"line\"><span class=\"kn\">from</span><span class=\"w\"> </span><span class=\"nn\">cryptography.hazmat.primitives.kdf.hkdf</span><span class=\"w\"> </span><span class=\"kn\">import</span> <span class=\"n\">HKDF</span></span>\n<span class=\"line\"><span class=\"n\">qrypt_bytes</span> <span class=\"o\">=</span> <span class=\"n\">base64</span><span class=\"o\">.</span><span class=\"n\">b64decode</span><span class=\"p\">(</span><span class=\"n\">entropy_b64</span><span class=\"p\">)[:</span><span class=\"mi\">32</span><span class=\"p\">]</span></span>\n<span class=\"line\"><span class=\"n\">key</span> <span class=\"o\">=</span> <span class=\"n\">HKDF</span><span class=\"p\">(</span><span class=\"n\">hashes</span><span class=\"o\">.</span><span class=\"n\">SHA256</span><span class=\"p\">(),</span> <span class=\"mi\">32</span><span class=\"p\">,</span> <span class=\"kc\">None</span><span class=\"p\">,</span> <span class=\"sa\">b</span><span class=\"s2\">&quot;aes-256 key&quot;</span><span class=\"p\">)</span><span class=\"o\">.</span><span class=\"n\">derive</span><span class=\"p\">(</span></span>\n<span class=\"line\">    <span class=\"n\">qrypt_bytes</span> <span class=\"o\">+</span> <span class=\"n\">os</span><span class=\"o\">.</span><span class=\"n\">urandom</span><span class=\"p\">(</span><span class=\"mi\">32</span><span class=\"p\">))</span></span></code></pre></div>\n<p class=\"lbl\">Node</p>\n<div class=\"codebox\"><button class=\"copy\" data-target=\"c-prod-js\" aria-label=\"Copy Node production HKDF code\">Copy</button><pre class=\"hl\" tabindex=\"0\"><code id=\"c-prod-js\" data-lang=\"js\"><span class=\"line\"><span class=\"k\">import</span><span class=\"w\"> </span><span class=\"p\">{</span><span class=\"w\"> </span><span class=\"nx\">hkdfSync</span><span class=\"w\"> </span><span class=\"p\">}</span><span class=\"w\"> </span><span class=\"kr\">from</span><span class=\"w\"> </span><span class=\"s2\">&quot;node:crypto&quot;</span><span class=\"p\">;</span><span class=\"w\">  </span><span class=\"c1\">// put with the other imports</span></span>\n<span class=\"line\"><span class=\"kd\">const</span><span class=\"w\"> </span><span class=\"nx\">qryptBytes</span><span class=\"w\"> </span><span class=\"o\">=</span><span class=\"w\"> </span><span class=\"nx\">Buffer</span><span class=\"p\">.</span><span class=\"kr\">from</span><span class=\"p\">(</span><span class=\"nx\">body</span><span class=\"p\">.</span><span class=\"nx\">random</span><span class=\"p\">[</span><span class=\"mf\">0</span><span class=\"p\">],</span><span class=\"w\"> </span><span class=\"s2\">&quot;base64&quot;</span><span class=\"p\">).</span><span class=\"nx\">subarray</span><span class=\"p\">(</span><span class=\"mf\">0</span><span class=\"p\">,</span><span class=\"w\"> </span><span class=\"mf\">32</span><span class=\"p\">);</span></span>\n<span class=\"line\"><span class=\"kd\">const</span><span class=\"w\"> </span><span class=\"nx\">ikm</span><span class=\"w\"> </span><span class=\"o\">=</span><span class=\"w\"> </span><span class=\"nx\">Buffer</span><span class=\"p\">.</span><span class=\"nx\">concat</span><span class=\"p\">([</span><span class=\"nx\">qryptBytes</span><span class=\"p\">,</span><span class=\"w\"> </span><span class=\"nx\">randomBytes</span><span class=\"p\">(</span><span class=\"mf\">32</span><span class=\"p\">)]);</span></span>\n<span class=\"line\"><span class=\"kd\">const</span><span class=\"w\"> </span><span class=\"nx\">key</span><span class=\"w\"> </span><span class=\"o\">=</span><span class=\"w\"> </span><span class=\"nx\">Buffer</span><span class=\"p\">.</span><span class=\"kr\">from</span><span class=\"p\">(</span><span class=\"nx\">hkdfSync</span><span class=\"p\">(</span><span class=\"s2\">&quot;sha256&quot;</span><span class=\"p\">,</span><span class=\"w\"> </span><span class=\"nx\">ikm</span><span class=\"p\">,</span><span class=\"w\"> </span><span class=\"s2\">&quot;&quot;</span><span class=\"p\">,</span><span class=\"w\"> </span><span class=\"s2\">&quot;aes-256 key&quot;</span><span class=\"p\">,</span><span class=\"w\"> </span><span class=\"mf\">32</span><span class=\"p\">));</span></span></code></pre></div>\n<h2 id=\"h-trip\">Things that trip people up</h2>\n<ul><li><code>size</code> counts <strong>KiB</strong>, not bytes. Ask for <code>size=1</code> (1,024 bytes) and take 32 bytes.</li>\n<li>Base64-decode the string first; never use the text itself as the key.</li>\n<li>Live can return 429 about 1 s after a single prior call; wait 10 s or more and never loop.</li>\n<li>A wrong token returns <strong>403</strong>, the same as an exhausted quota. Check the token first.</li>\n<li>Never print, log or commit the key or token. Use fresh entropy for each key.</li></ul>\n<p>Errors? See <a href=\"/troubleshooting\">Troubleshooting</a>.</p>\n<section id=\"h-agent\" class=\"agent-section\">\n<h2>For AI coding agents — Quick Setup and Isolated Setup</h2>\n<p>Machine-readable rules: <a href=\"/llms.txt\"><code>llms.txt</code></a>. Full rules for humans and agents are also in <code>AGENTS.md</code> in the <a href=\"/qrypt-quickstart-starter.zip\">starter archive</a>. Paste a short prompt below; the agent should get everything else from those docs.</p>\n<p>Two modes. <strong>Quick Setup is the default</strong> (no Docker). Isolated Setup is optional when you want stronger credential boundaries.</p>\n\n<table class=\"cmp\"><caption>Quick Setup vs Isolated Setup</caption>\n<thead><tr><th scope=\"col\"></th><th scope=\"col\">Quick Setup (default)</th><th scope=\"col\">Isolated Setup</th></tr></thead>\n<tbody>\n<tr><th scope=\"row\">Best for</th><td>Trying the API in under 10 minutes with Claude Code, Codex, Cursor or similar</td><td>Repos that already hold secrets, or any run where the agent must not see credentials</td></tr>\n<tr><th scope=\"row\">Docker required</th><td>No</td><td>Yes</td></tr>\n<tr><th scope=\"row\">Agent can access existing project secrets</th><td>Yes — unrestricted agents can read files, including <code>.env</code></td><td>No — project must not contain <code>.env</code>; host secrets stay off the mount</td></tr>\n<tr><th scope=\"row\">Credential exposure risk</th><td>Behavioral only. Agents may log file contents. Use a disposable token.</td><td>Token never enters the agent container. Live verify runs fixed snippets on the host.</td></tr>\n<tr><th scope=\"row\">Human credential setup</th><td>You create <code>.env</code> yourself; never paste the token into chat</td><td>You keep <code>.env</code> outside the project (e.g. <code><span class=\"nb\">~/.config/qrypt/.env</span></code>)</td></tr>\n<tr><th scope=\"row\">Live verification</th><td>Agent runs the example after you confirm <code>.env</code> is set</td><td>You run <code><span class=\"nb\">agent-sandbox/verify.sh</span> <span class=\"nb\">--env</span> …</code> (sanitized PASS/FAIL only)</td></tr>\n</tbody></table>\n\n<details open id=\"quick-setup\">\n<summary><strong>Option A — Quick Setup</strong> (default, no Docker)</summary>\n<div class=\"warn\" role=\"note\">\n<p><strong>Security warning.</strong> AI coding agents may access files containing credentials, including existing <code>.env</code> files, before reading these instructions. Credential values could appear in agent session logs. For this quick setup, use disposable API credentials where possible and rotate any credentials that were exposed or may have been compromised. For stronger protection, choose Isolated Setup.</p>\n</div>\n<ol>\n<li>Paste this prompt into Claude Code, Codex, Cursor or another coding agent:\n<div class=\"codebox\"><button class=\"copy\" data-target=\"c-prompt\" aria-label=\"Copy Quick Setup agent prompt\">Copy</button>\n<pre class=\"hl\" tabindex=\"0\"><code id=\"c-prompt\" data-lang=\"text\"><span class=\"line\">Set up the Qrypt quickstart and run the Python snippet.</span>\n<span class=\"line\">Follow <span class=\"url\">https://qrypt-quickstart.pages.dev/</span> and <span class=\"url\">https://qrypt-quickstart.pages.dev/llms.txt.</span></span></code></pre></div></li>\n<li>The agent reads the quickstart, picks a language, implements with the official snippets and runs the mock tests.</li>\n<li>When asked, create <code>.env</code> yourself (never paste the token into the chat):\n<div class=\"codebox\"><button class=\"copy\" data-target=\"c-env2\" aria-label=\"Copy .env example line\">Copy</button>\n<pre class=\"hl\" tabindex=\"0\"><code id=\"c-env2\" data-lang=\"env\"><span class=\"line\"><span class=\"nv\">QRYPT_API_KEY</span><span class=\"o\">=</span>paste-your-token-here</span></code></pre></div>\nTell the agent only that it is set. Do not share the value.</li>\n<li>The agent runs the example (1 KiB → 32-byte AES-256 key → AES-GCM round trip) and reports the success line without displaying secrets.</li>\n</ol>\n<p class=\"warn\"><strong>End-of-workflow reminder:</strong> Review your agent session for potential credential exposure. Rotate any exposed or potentially compromised API credentials, including unrelated project credentials. Rotating the Qrypt token alone does not protect other secrets.</p>\n<p>These rules are defense-in-depth, not enforceable isolation. Rotation does not make an earlier exposure harmless, and nothing here claims a no-logging guarantee. Prefer Isolated Setup when that matters.</p>\n</details>\n\n<details id=\"isolated-setup\">\n<summary><strong>Option B — Isolated Setup</strong> (Docker; agent never sees the token)</summary>\n<p>The agent runs in a container with <strong>no</strong> <code>.env</code>, no host home, no SSH keys, no cloud credentials and no Docker socket. Live verification is a separate host-side step that runs <em>fixed</em> snippets from this repo — never agent-modifiable code — with the real token.</p>\n<p>Sample agent prompt (after the sandbox is running against a clean project):</p>\n<div class=\"codebox\"><button class=\"copy\" data-target=\"c-prompt-iso\" aria-label=\"Copy Isolated Setup agent prompt\">Copy</button>\n<pre class=\"hl\" tabindex=\"0\"><code id=\"c-prompt-iso\" data-lang=\"text\"><span class=\"line\">Use Isolated Setup for the Qrypt quickstart in this folder (see <span class=\"nb\">QRYPT-ISOLATED.txt</span>).</span>\n<span class=\"line\">Follow <span class=\"url\">https://qrypt-quickstart.pages.dev/</span> and <span class=\"url\">https://qrypt-quickstart.pages.dev/llms.txt.</span></span></code></pre></div>\n<ol>\n<li>Download and unzip the <a href=\"/qrypt-quickstart-starter.zip\">starter archive</a>. It holds the <code><span class=\"nb\">agent-sandbox/</span></code> folder (Dockerfile, <code>run.sh</code>, <code>verify.sh</code>, <code><span class=\"nb\">test-isolation.sh</span></code>, README) plus the fixed snippets that <code>verify.sh</code> runs. Run the commands below from the unzipped folder. (Single files are still at <a href=\"/agent-sandbox/README.md\">/agent-sandbox/</a>.)</li>\n<li>Keep the token <em>outside</em> the project the agent will see:\n<div class=\"codebox\"><button class=\"copy\" data-target=\"c-iso-env\" aria-label=\"Copy isolated env setup commands\">Copy</button>\n<pre class=\"hl\" tabindex=\"0\"><code id=\"c-iso-env\" data-lang=\"bash\"><span class=\"line\">mkdir<span class=\"w\"> </span>-p<span class=\"w\"> </span>~/.config/qrypt</span>\n<span class=\"line\"><span class=\"c1\"># put QRYPT_API_KEY=... in ~/.config/qrypt/.env, then:</span></span>\n<span class=\"line\">chmod<span class=\"w\"> </span><span class=\"m\">600</span><span class=\"w\"> </span>~/.config/qrypt/.env</span></code></pre></div></li>\n<li>Start the agent against a clean project directory (must not contain <code>.env</code> — <code>run.sh</code> refuses otherwise):\n<div class=\"codebox\"><button class=\"copy\" data-target=\"c-iso-run\" aria-label=\"Copy isolated run command\">Copy</button>\n<pre class=\"hl\" tabindex=\"0\"><code id=\"c-iso-run\" data-lang=\"bash\"><span class=\"line\">agent-sandbox/run.sh<span class=\"w\"> </span>~/qrypt-demo<span class=\"w\"> </span>your-agent-command</span></code></pre></div></li>\n<li>Inside the container the agent implements the example and runs mock tests. It has no token.</li>\n<li>On the host, after the agent finishes, run trusted verification:\n<div class=\"codebox\"><button class=\"copy\" data-target=\"c-iso-verify\" aria-label=\"Copy verify command\">Copy</button>\n<pre class=\"hl\" tabindex=\"0\"><code id=\"c-iso-verify\" data-lang=\"bash\"><span class=\"line\">agent-sandbox/verify.sh<span class=\"w\"> </span>--env<span class=\"w\"> </span>~/.config/qrypt/.env</span>\n<span class=\"line\"><span class=\"c1\"># -&gt; verify python: PASS (AES-GCM round trip; key not shown)</span></span></code></pre></div></li>\n</ol>\n<p><strong>Honesty about isolation:</strong> this blocks the common failure mode (agents reading <code>.env</code>). It does <em>not</em> claim Docker guarantees zero leakage. A malicious <code>SANDBOX_DOCKER_ARGS</code> that remounts your home directory, a compromised agent binary, or a container escape is out of scope. The boundaries we <em>do</em> claim are checked by <code><span class=\"nb\">agent-sandbox/test-isolation.sh</span></code>.</p>\n</details>\n</section>\n\n<p id=\"copy-status\" class=\"sr\" aria-live=\"polite\"></p></main><footer class=\"foot\"><p>Unofficial prototype built on the public API docs; not a Qrypt product and not endorsed by Qrypt. API reference: <a href=\"https://docs.qrypt.com/eaas/\">docs.qrypt.com/eaas</a>. No analytics or cookies.</p></footer></div>\n<script src=\"/app.js\" defer></script></body></html>\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"curl -fsSL https://qrypt-quickstart.pages.dev/qrypt-quickstart-starter.zip -o /tmp/qrypt-starter.zip\npython3 - <<'PY'\nimport zipfile\nwith zipfile.ZipFile('/tmp/qrypt-starter.zip') as z:\n print('\\\\n'.join(z.namelist()))\n z.extractall('/work')\nPY\ncat AGENTS.md Makefile mock/run_cases.sh agent-sandbox/verify.sh\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"curl -fsSL https://qrypt-quickstart.pages.dev/qrypt-quickstart-starter.zip -o /tmp/qrypt-starter.zip\npython3 - <<'PY'\nimport zipfile\nwith zipfile.ZipFile('/tmp/qrypt-starter.zip') as z:\n print('\\\\n'.join(z.namelist()))\n z.extractall('/work')\nPY\ncat AGENTS.md Makefile mock/run_cases.sh agent-sandbox/verify.sh\"","aggregated_output":"qrypt-quickstart/AGENTS.md\nqrypt-quickstart/Makefile\nqrypt-quickstart/.env.example\nqrypt-quickstart/quickstart/python/quickstart.py\nqrypt-[REDACTED_B64].txt\nqrypt-quickstart/quickstart/node/quickstart.mjs\nqrypt-quickstart/mock/server.py\nqrypt-quickstart/mock/run_cases.sh\nqrypt-quickstart/agent-sandbox/Dockerfile\nqrypt-quickstart/agent-sandbox/README.md\nqrypt-quickstart/agent-sandbox/run.sh\nqrypt-quickstart/agent-sandbox/verify.sh\nqrypt-quickstart/agent-sandbox/test-isolation.sh\ncat: AGENTS.md: No such file or directory\ncat: Makefile: No such file or directory\ncat: mock/run_cases.sh: No such file or directory\ncat: agent-sandbox/verify.sh: No such file or directory\n","exit_code":1,"status":"failed"}}
