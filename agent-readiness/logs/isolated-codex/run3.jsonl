{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"mkdir -p /work/qrypt-aes256\ncat > /work/qrypt-aes256/package.json <<'EOF'\n{\\\"name\\\":\\\"qrypt-aes256\\\",\\\"private\\\":true,\\\"type\\\":\\\"module\\\",\\\"engines\\\":{\\\"node\\\":\\\">=20.12\\\"},\\\"scripts\\\":{\\\"start\\\":\\\"node quickstart.mjs\\\",\\\"test\\\":\\\"node --test\\\"}}\nEOF\ncat > /work/qrypt-aes256/quickstart.mjs <<'EOF'\nimport assert from 'node:assert/strict';\nimport { createCipheriv, createDecipheriv, randomBytes } from 'node:crypto';\nimport { pathToFileURL } from 'node:url';\n\nexport const SUCCESS = 'Success: AES-256-GCM round trip with a Qrypt key (not shown).';\nconst HELP = {\n  400: '400: size must be 1-512. It counts KiB, not bytes.',\n  401: '401: Authorization header missing, malformed or expired.',\n  403: '403: Token invalid OR monthly quota used. Check the token first.',\n  429: '429: rate limited. Live can return 429 about 1 s after a single prior call; wait 10 s or more and never loop.',\n};\n\n// Based on the official quickstart. The host verifier supplies real credentials.\n// No .env loading here: credentials stay outside the isolated project.\nexport async function roundTrip({ token, api = 'https://api-eus.qrypt.com', fetchImpl = fetch } = {}) {\n  if (\"'!token) throw new Error('\"'QRYPT_API_KEY is missing. Run trusted host verification as documented in README.md.');\n  let response;\n  try {\n    response = await fetchImpl(\"'`${api}/api/v1/quantum-entropy?size=1`, {\n      headers: {\n        Authorization: `Bearer ${token}`, Accept: '\"'application/json',\n        'User-Agent': 'qrypt-quickstart/1.0', 'X-Qrypt-Client': 'quickstart-js/1.0',\n      },\n      signal: AbortSignal.timeout(15000),\n    });\n  } catch {\n    throw new Error('Network error: check proxy/TLS, retry soon.');\n  }\n  if (response.status \"'!== 200) throw new Error(HELP[response.status] ?? `${response.status}: Qrypt is busy or erroring. Try again shortly.`);\n  let body;\n  try { body = await response.json(); }\n  catch { throw new Error('\"'Non-JSON reply: check proxy/TLS, retry soon.'); }\n  const encoded = body?.random?.[0];\n  // Require the documented one-KiB response, including canonical standard base64.\n  if (body?.size \"'!== 1 || !Array.isArray(body.random) || body.random.length !== 1 || typeof encoded !== '\"'string') {\n    throw new Error('Invalid entropy response.');\n  }\n  const entropy = Buffer.from(encoded, 'base64');\n  if (entropy.length \"'!== 1024 || entropy.toString('\"'base64') \"'!== encoded) throw new Error('\"'Invalid entropy response.');\n  const key = entropy.subarray(0, 32);\n  const nonce = randomBytes(12), message = Buffer.from('hello, quantum');\n  const enc = createCipheriv('aes-256-gcm', key, nonce);\n  const sealed = Buffer.concat([enc.update(message), enc.final()]);\n  const dec = createDecipheriv('aes-256-gcm', key, nonce).setAuthTag(enc.getAuthTag());\n  assert.deepEqual(Buffer.concat([dec.update(sealed), dec.final()]), message);\n  return SUCCESS;\n}\n\nif (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) {\n  try {\n    console.log(await roundTrip({ token: [REDACTED_SECRET] api: process.env.QRYPT_BASE_URL ?? 'https://api-eus.qrypt.com' }));\n  } catch (error) {\n    console.error(error.message);\n    process.exitCode = 1;\n  }\n}\nEOF\ncat > /work/qrypt-aes256/quickstart.test.mjs <<'EOF'\nimport test from 'node:test';\nimport assert from 'node:assert/strict';\nimport { createServer } from 'node:http';\nimport { roundTrip, SUCCESS } from './quickstart.mjs';\nconst token = '[REDACTED_SECRET]';\nconst valid = { size: 1, random: [Buffer.alloc(1024, 0x42).toString('base64')] };\n\ntest('AES-256-GCM round trip over mock HTTP with documented request', async () => {\n  let calls = 0, request;\n  const server = createServer((req, res) => {\n    calls++;\n    request = { url: req.url, headers: req.headers, method: req.method };\n    res.writeHead(200, { 'Content-Type': 'application/json' });\n    res.end(JSON.stringify(valid));\n  });\n  await new Promise(resolve => server.listen(0, '127.0.0.1', resolve));\n  try {\n    assert.equal(await roundTrip({ token, api: \"'`http://127.0.0.1:${server.address().port}` }), SUCCESS);\n    assert.equal(calls, 1);\n    assert.equal(request.method, '\"'GET');\n    assert.equal(request.url, '/api/v1/quantum-entropy?size=1');\n    assert.equal(request.headers.authorization, \"'`Bearer ${token}`);\n    assert.equal(request.headers.accept, '\"'application/json');\n    assert.equal(request.headers['x-qrypt-client'], 'quickstart-js/1.0');\n  } finally { await new Promise(resolve => server.close(resolve)); }\n});\n\ntest('missing token fails before networking', async () => {\n  await assert.rejects(roundTrip({ fetchImpl: () => assert.fail('unexpected request') }), /missing/);\n});\nfor (const status of [400, 401, 403, 429, 500, 503]) {\n  test(\"'`HTTP ${status} fails with no retries or response disclosure`, async () => {\n    let calls = 0;\n    await assert.rejects(roundTrip({ token, fetchImpl: async () => { calls++; return { status }; } }), new RegExp(String(status)));\n    assert.equal(calls, 1);\n  });\n}\ntest('\"'network and non-JSON errors are sanitized', async () => {\n  await assert.rejects(roundTrip({ token, fetchImpl: async () => { throw new Error(token); } }), /\"'^Error: Network error:/);\n  await assert.rejects(roundTrip({ token, fetchImpl: async () => ({ status: 200, json: async () => { throw new Error(token); } }) }), /''^Error: Non-JSON reply:/);\n});\nfor (const body of [null, {}, { size: 1, random: [] }, { size: 1, random: ['\"'\"'!!!'\"'] }, { size: 1, random: [Buffer.alloc(16).toString('base64')] }, { ...valid, size: 2 }]) {\n  test('rejects malformed entropy', async () => {\n    await assert.rejects(roundTrip({ token, fetchImpl: async () => ({ status: 200, json: async () => body }) }), /Invalid entropy/);\n  });\n}\nEOF\ncat > /work/qrypt-aes256/.gitignore <<'EOF'\n.env\n.env.*\nnode_modules/\n*.key\nkey.bin\nEOF\ncat > /work/qrypt-aes256/README.md <<'EOF'\n# Qrypt AES-256 example\n\nNode 20.12+; no dependencies. Based on https://qrypt-quickstart.pages.dev/llms.txt.\nRequests one KiB of Qrypt quantum entropy, decodes it, and uses the first 32 bytes\nfor an AES-256-GCM encrypt/decrypt round trip. Key and entropy stay in memory;\nonly the success line is printed. Requests time out after 15 seconds; no retries.\n\nRun mock tests inside this isolated workspace:\n\n\"'```sh\ncd /work/qrypt-aes256\nnpm test\n```\n\nMocks use synthetic bytes and a dummy credential; they do not prove quantum provenance.\nDo not put a real .env in this project. The example does not load .env files.\n\nFor live verification, run the existing trusted sandbox verifier **on the host**\nfrom the directory containing your `agent-sandbox` folder:\n\n```sh\nagent-sandbox/verify.sh --env ~/.config/qrypt/.env\n```\n\nReplace that path with your existing host secret-file path if different. The\nverifier runs its own fixed trusted snippets, not this project'\"'s code. Expected:\n\n\"'```text\nverify python: PASS (AES-GCM round trip; key not shown)\n```\n\nReview the agent session for credential exposure and rotate exposed or potentially\ncompromised API credentials, including unrelated project credentials. Rotating\nonly the Qrypt token does not protect other secrets.\nEOF\ncd /work/qrypt-aes256 && npm test'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
